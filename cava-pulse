#!/usr/bin/env python3
"""Safely publish bounded Cava frames in a private cache directory."""

import fcntl
import os
import re
import stat
import subprocess
import sys

MAX_FRAME_BYTES = 4096
ZERO_FRAME = ("0;" * 27) + "0\n"
FRAME_RE = re.compile(rb"[0-9;]+\r?\n?\Z")


def fail(message):
    print(f"cava-pulse: {message}", file=sys.stderr)
    raise SystemExit(1)


def open_cache_dir(state_path):
    cache_dir = os.path.abspath(os.path.dirname(state_path))
    expected = os.path.join(os.path.expanduser("~"), ".cache", "cava-now-playing")
    if cache_dir != expected or os.path.basename(state_path) != "bars":
        fail("state path must be ~/.cache/cava-now-playing/bars")
    try:
        os.mkdir(cache_dir, 0o700)
    except FileExistsError:
        pass
    try:
        directory = os.open(cache_dir, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except OSError as error:
        fail(f"refusing cache directory: {error}")
    info = os.fstat(directory)
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.geteuid():
        os.close(directory)
        fail("cache directory is not an owned directory")
    os.fchmod(directory, 0o700)
    return directory


def secure_open(directory, name, flags, mode=0o600):
    try:
        descriptor = os.open(name, flags | os.O_NOFOLLOW | os.O_CLOEXEC, mode, dir_fd=directory)
    except OSError as error:
        fail(f"refusing {name}: {error}")
    info = os.fstat(descriptor)
    if not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid():
        os.close(descriptor)
        fail(f"refusing non-regular or unowned {name}")
    return descriptor


def publish(directory, frame):
    if not isinstance(frame, bytes) or len(frame) > MAX_FRAME_BYTES or not FRAME_RE.fullmatch(frame):
        return False
    if not frame.endswith(b"\n"):
        frame += b"\n"
    temporary = f".bars.{os.getpid()}"
    descriptor = secure_open(directory, temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL)
    try:
        os.write(descriptor, frame)
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
    try:
        os.replace(temporary, "bars", src_dir_fd=directory, dst_dir_fd=directory)
    except OSError as error:
        try:
            os.unlink(temporary, dir_fd=directory)
        except OSError:
            pass
        fail(f"publishing frame: {error}")
    return True


def read_frame(state_path):
    directory = open_cache_dir(state_path)
    try:
        descriptor = secure_open(directory, "bars", os.O_RDONLY)
        try:
            info = os.fstat(descriptor)
            if info.st_size > MAX_FRAME_BYTES:
                return 1
            frame = os.read(descriptor, MAX_FRAME_BYTES + 1)
            if len(frame) > MAX_FRAME_BYTES or not FRAME_RE.fullmatch(frame):
                return 1
            os.write(sys.stdout.fileno(), frame)
            return 0
        finally:
            os.close(descriptor)
    except SystemExit:
        return 1
    finally:
        os.close(directory)


def write_log(directory, message):
    descriptor = secure_open(directory, "cava.log", os.O_WRONLY | os.O_CREAT | os.O_TRUNC)
    os.write(descriptor, message.encode())
    return descriptor


def run_cava(config_path, state_path):
    directory = open_cache_dir(state_path)
    try:
        lock = secure_open(directory, "lock", os.O_RDWR | os.O_CREAT)
        try:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                return 0
            publish(directory, ZERO_FRAME.encode())
            if not any(os.access(os.path.join(path, "cava"), os.X_OK)
                           for path in os.environ.get("PATH", "").split(os.pathsep)):
                log = write_log(directory, "Cava is not installed. Install it with: omarchy pkg add cava\n")
                os.close(log)
                return 0
            log = secure_open(directory, "cava.log", os.O_WRONLY | os.O_CREAT | os.O_TRUNC)
            try:
                process = subprocess.Popen(["cava", "-p", config_path], stdout=subprocess.PIPE, stderr=log)
                assert process.stdout is not None
                while True:
                    frame = process.stdout.readline(MAX_FRAME_BYTES + 1)
                    if not frame:
                        break
                    if len(frame) > MAX_FRAME_BYTES:
                        # readline(limit) returns a prefix of a long line; drain
                        # its remainder in bounded chunks before accepting another.
                        while frame and not frame.endswith(b"\n"):
                            frame = process.stdout.readline(MAX_FRAME_BYTES + 1)
                        continue
                    publish(directory, frame)
                return process.wait()
            finally:
                os.close(log)
        finally:
            os.close(lock)
    finally:
        os.close(directory)


if __name__ == "__main__":
    if len(sys.argv) == 3 and sys.argv[1] == "--read":
        raise SystemExit(read_frame(sys.argv[2]))
    if len(sys.argv) != 3:
        fail("usage: cava-pulse CAVA_CONFIG STATE_PATH | cava-pulse --read STATE_PATH")
    raise SystemExit(run_cava(sys.argv[1], sys.argv[2]))
